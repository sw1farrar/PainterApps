NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (auth + saved locations/jobs + optional weather cache + TDS tables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Mapbox style. MapLibre + OpenFreeMap works without this.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Coatings news editor (comma-separated Supabase user ids). Or set profiles.is_editor.
NEWS_EDITOR_USER_IDS=

# Brevo transactional email (auth confirm + password reset)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@painterapps.com
BREVO_SENDER_NAME=PainterApps
SEND_EMAIL_HOOK_SECRET=
