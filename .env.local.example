NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Supabase database password (Settings → Database) for automatic SQL migrations.
# When set, pending catalog migrations apply on admin page load — no manual SQL needed.
# SUPABASE_DB_PASSWORD=your-database-password
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME=PainterApps
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_PLACES_API_KEY=

# Google Images (Custom Product can picker) — enable "Custom Search API" in Google Cloud,
# then create a Programmable Search Engine (search the entire web, Image search ON).
# GOOGLE_CUSTOM_SEARCH_API_KEY=   # optional; falls back to GOOGLE_PLACES_API_KEY
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# xAI (Grok) — create an API key at https://console.x.ai
# Paste your key on the line below (no quotes).
# Site admins choose Premium vs Economy at /app/admin/settings (stored in site_settings).
# XAI_MODEL is only a local-dev fallback when site_settings is unavailable.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1